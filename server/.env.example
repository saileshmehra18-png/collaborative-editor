# Server configuration
PORT=4000
NODE_ENV=development

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret

# Use a path on your hosting provider's persistent disk in production.
DATABASE_PATH=./data/app.db

# Optional comma-separated browser origins when hosting the frontend separately.
# Same-origin deployments do not need this setting.
# CORS_ORIGIN=https://your-frontend.example.com
